#!/usr/bin/env perl
# oldagent - a tiny agent for old perl and older machines.
# Run `oa doctor` first on any box you have never seen.

# a perl older than 5.006 cannot compile the tree (no warnings.pm, no
# our, no foreach my ...). before anything below is even parsed, hand
# over to oa1, the one-file edition next to this script. only perl 5.000
# syntax in this block. OA_MINIMAL=1 forces the handover on any perl.
BEGIN {
    if ($] < 5.006 || $ENV{OA_MINIMAL}) {
        my $self = $0;
        my $t = -l $self ? readlink($self) : undef;
        if (defined $t) {
            $self =~ s{[^/]*$}{};
            $self = ($t =~ m{^/}) ? $t : "$self$t";
        }
        my $dir = $self;
        $dir =~ s{[^/]*$}{};
        $dir = './' unless length $dir;
        my $oa1 = "${dir}oa1";
        if (-f $oa1) {
            print STDERR "oa: this perl is $], older than oa needs (5.006); running oa1, the one-file edition\n"
                unless $ENV{OA_MINIMAL} || grep { $_ eq '-q' || $_ eq '--quiet' } @ARGV;
            exec($^X, $oa1, @ARGV);
            die "oa: could not start $oa1: $!\n";
        }
        die "oa: this perl is $] and oa needs 5.006; the one-file edition oa1 is for a perl this old, but it is not next to $0\n"
            if $] < 5.006;
    }
}

use strict;
use warnings;

use 5.006;
use File::Basename ();
use File::Spec ();
use Cwd ();

BEGIN {
    # find lib/ next to this script, following one level of symlink if needed
    my @try;
    my $self = $0;
    push @try, File::Basename::dirname($self);
    if (-l $self) {
        my $t = eval { readlink($self) };
        if (defined $t) {
            $t = File::Spec->catfile(File::Basename::dirname($self), $t)
                unless File::Spec->file_name_is_absolute($t);
            push @try, File::Basename::dirname($t);
        }
    }
    my $abs = eval { Cwd::abs_path($self) };
    push @try, File::Basename::dirname($abs) if defined $abs;
    push @try, split(/:/, ($ENV{OLDAGENT_LIB} || ''));
    for my $d (@try) {
        next unless defined $d && length $d;
        my $lib = File::Spec->catdir($d, 'lib');
        if (-d $lib && -f File::Spec->catfile($lib, 'OldAgent.pm')) {
            unshift @INC, $lib;
            last;
        }
    }
}

use OldAgent::CLI ();

my $rc = eval { OldAgent::CLI::run(argv => [@ARGV]) };
if ($@) {
    print STDERR "oldagent: internal error: $@\n";
    print STDERR "try: oa doctor\n";
    exit 70;
}
exit($rc || 0);
