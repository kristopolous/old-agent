#!/usr/bin/perl
# oa1 - oldagent in one file, for perl 5.001 (OPENSTEP 4.2, NeXTSTEP,
# SunOS 4, early Linux). the dialect is perl 5.000: references, my, =>,
# closures called as &$f(), named signal handlers, two-argument open with
# bareword filehandles. nothing newer: no our, no foreach my, no qr//,
# no $f->(), no three-argument open, no POSIX, IO::*, File::Spec.
#
# it speaks the same tool protocol as oa (```tool blocks in, ```result
# blocks back), reads the same ~/.oldagentrc, and talks to ollama's native
# /api/chat (streaming) or an OpenAI-compatible /v1/chat/completions over
# a raw socket. http only: a box this old has no TLS anyway; point it at
# oa-proxy or a local model.
#
#   oa1                      interactive, tools on
#   oa1 ask "text"           one question, no tools
#   oa1 do "text"            one task, tools on
#   oa1 models               what the endpoint serves
#   oa1 config               the settings in use
#   oa1 --base-url http://10.0.0.1:11434 --model qwen3.8 do "uptime?"
use strict;
use Socket;
use Config;

my $VERSION = '0.1.13';

# ---------------------------------------------------------------- state --
my %cfg = (
    provider => 'ollama',
    base_url => 'http://127.0.0.1:11434',
    model    => '',
    api_key  => '',
    approve  => 'ask',       # ask | auto | off
    tools    => 1,
    turns    => 12,
    timeout  => 0,          # seconds per model call; 0 = wait forever
    thinking => '',        # 1 forces reasoning on, 0 off; empty = the model decides
    quiet    => 0,
    debug    => 0,
    ascii    => -1,          # fold utf-8 punctuation to ascii; -1 = unless LANG says utf-8
    rcfile   => '',
    noconfig => 0,
    system_extra => '',
);
my @hist;                    # { role => ..., content => ... }
sub set_cfg { $cfg{$_[0]} = $_[1] }      # for the tests
my $cmd_pid    = 0;          # the bash child, for the timeout handler
my $cmd_killed = 0;

# ------------------------------------------------------------------ json --
# encode: a reference to a scalar is emitted raw (\"1", \"true", \"null").
sub json_str {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/\\/\\\\/g;
    $s =~ s/"/\\"/g;
    $s =~ s/\n/\\n/g;
    $s =~ s/\r/\\r/g;
    $s =~ s/\t/\\t/g;
    $s =~ s/([\x00-\x1f])/sprintf("\\u%04x", ord($1))/ge;
    return '"' . $s . '"';
}

sub json_enc {
    my ($v) = @_;
    my $r = ref($v);
    return 'null' unless defined $v;
    return $$v if $r eq 'SCALAR';
    if ($r eq 'ARRAY') {
        my ($x, @o);
        for $x (@$v) { push @o, json_enc($x) }
        return '[' . join(',', @o) . ']';
    }
    if ($r eq 'HASH') {
        my ($k, @o);
        for $k (sort keys %$v) { push @o, json_str($k) . ':' . json_enc($v->{$k}) }
        return '{' . join(',', @o) . '}';
    }
    return json_str($v);
}

# decode: index-based recursive descent over one string. true/false come
# back as 1/0, null as undef. returns (value, error).
my ($js, $ji, $jerr);

sub json_dec {
    my ($s) = @_;
    $js = defined $s ? $s : '';
    $ji = 0;
    $jerr = '';
    my $v = jv();
    return (undef, $jerr) if $jerr;
    jws();
    return (undef, "trailing characters at $ji") if $ji < length $js;
    return ($v, '');
}

sub jws {
    my $c;
    while ($ji < length $js) {
        $c = substr($js, $ji, 1);
        last unless $c eq ' ' || $c eq "\t" || $c eq "\n" || $c eq "\r";
        $ji++;
    }
}

sub jv {
    return undef if $jerr;
    jws();
    my $c = substr($js, $ji, 1);
    if ($c eq '{') {
        $ji++;
        my %h;
        jws();
        if (substr($js, $ji, 1) eq '}') { $ji++; return \%h }
        while (1) {
            jws();
            if (substr($js, $ji, 1) ne '"') { $jerr = "expected key at $ji"; return undef }
            my $k = jstr();
            return undef if $jerr;
            jws();
            if (substr($js, $ji, 1) ne ':') { $jerr = "expected : at $ji"; return undef }
            $ji++;
            my $val = jv();
            return undef if $jerr;
            $h{$k} = $val;
            jws();
            $c = substr($js, $ji, 1);
            if ($c eq ',') { $ji++; next }
            if ($c eq '}') { $ji++; return \%h }
            $jerr = "expected , or } at $ji";
            return undef;
        }
    }
    if ($c eq '[') {
        $ji++;
        my @l;
        jws();
        if (substr($js, $ji, 1) eq ']') { $ji++; return \@l }
        while (1) {
            my $val = jv();
            return undef if $jerr;
            push @l, $val;
            jws();
            $c = substr($js, $ji, 1);
            if ($c eq ',') { $ji++; next }
            if ($c eq ']') { $ji++; return \@l }
            $jerr = "expected , or ] at $ji";
            return undef;
        }
    }
    return jstr() if $c eq '"';
    if (substr($js, $ji, 4) eq 'true')  { $ji += 4; return 1 }
    if (substr($js, $ji, 5) eq 'false') { $ji += 5; return 0 }
    if (substr($js, $ji, 4) eq 'null')  { $ji += 4; return undef }
    my $t = substr($js, $ji, 40);
    if ($t =~ /^(-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)/) {
        $ji += length $1;
        return $1 + 0;
    }
    $jerr = ($ji >= length $js) ? 'unexpected end of input' : "unexpected '$c' at $ji";
    return undef;
}

# a string: the opening quote is at $ji. runs between escapes are taken
# with index(), so a long text costs one index per escape, not one
# substr per character.
sub jstr {
    $ji++;
    my $out = '';
    my ($q, $bs, $e, $n);
    while (1) {
        $q  = index($js, '"', $ji);
        if ($q < 0) { $jerr = 'unterminated string'; return undef }
        $bs = index($js, '\\', $ji);
        if ($bs < 0 || $bs > $q) {
            $out .= substr($js, $ji, $q - $ji);
            $ji = $q + 1;
            return $out;
        }
        $out .= substr($js, $ji, $bs - $ji);
        $e = substr($js, $bs + 1, 1);
        $ji = $bs + 2;
        if    ($e eq 'n') { $out .= "\n" }
        elsif ($e eq 't') { $out .= "\t" }
        elsif ($e eq 'r') { $out .= "\r" }
        elsif ($e eq 'b') { $out .= "\b" }
        elsif ($e eq 'f') { $out .= "\f" }
        elsif ($e eq 'u') {
            $n = hex(substr($js, $ji, 4));
            $ji += 4;
            if ($n >= 0xd800 && $n <= 0xdbff && substr($js, $ji, 2) eq '\\u') {
                my $lo = hex(substr($js, $ji + 2, 4));
                if ($lo >= 0xdc00 && $lo <= 0xdfff) {
                    $ji += 6;
                    $n = 0x10000 + (($n - 0xd800) << 10) + ($lo - 0xdc00);
                }
            }
            $out .= utf8_bytes($n);
        }
        else { $out .= $e }     # \" \\ \/ and anything unknown
    }
}

sub utf8_bytes {
    my ($n) = @_;
    return chr($n) if $n < 0x80;
    return pack('C2', 0xc0 | ($n >> 6), 0x80 | ($n & 0x3f)) if $n < 0x800;
    return pack('C3', 0xe0 | ($n >> 12), 0x80 | (($n >> 6) & 0x3f), 0x80 | ($n & 0x3f))
        if $n < 0x10000;
    return pack('C4', 0xf0 | ($n >> 18), 0x80 | (($n >> 12) & 0x3f),
                      0x80 | (($n >> 6) & 0x3f), 0x80 | ($n & 0x3f));
}

# ------------------------------------------------------------------ http --
# one request over a raw socket, HTTP/1.0 (so the server neither chunks
# nor keeps the connection). with a line callback the body is handed over
# line by line as it arrives (ollama streams NDJSON that way); without
# one the whole body comes back. returns (status, body, error).
my $http_timed_out = 0;
sub http_timeout { $http_timed_out = 1; die "timeout\n" }

sub http_req {
    my ($method, $url, $body, $cb) = @_;
    return (0, '', "oa1 speaks http only, not $1 (use oa-proxy or a local model): $url")
        if $url =~ m!^(https)://!i;
    return (0, '', "bad url: $url") unless $url =~ m!^http://([^/:]+)(?::(\d+))?(/.*)?$!i;
    my ($host, $port, $path) = ($1, $2, $3);
    $port = 80 unless defined $port && length $port;
    $path = '/' unless defined $path && length $path;

    my $addr;
    if ($host =~ /^\d+\.\d+\.\d+\.\d+$/) {
        $addr = pack('C4', split(/\./, $host));     # old resolvers choke on dotted quads
    } else {
        $addr = (gethostbyname($host))[4];
        return (0, '', "cannot resolve $host") unless defined $addr;
    }
    my $proto = (getprotobyname('tcp'))[2];
    $proto = 6 unless defined $proto;

    my $req = "$method $path HTTP/1.0\r\nHost: $host\r\nConnection: close\r\n";
    $req .= "Authorization: Bearer $cfg{api_key}\r\n" if length $cfg{api_key};
    $req .= "User-Agent: oa1/$VERSION\r\n";
    if (defined $body) {
        $req .= "Content-Type: application/json\r\nContent-Length: " . length($body) . "\r\n";
    }
    $req .= "\r\n";
    $req .= $body if defined $body;

    my ($status, $out, $err) = (0, '', '');
    my $chunked = 0;
    $http_timed_out = 0;
    local $SIG{ALRM} = 'http_timeout';
    local $SIG{PIPE} = 'IGNORE';
    alarm($cfg{timeout}) if $cfg{timeout} > 0;
    eval {
        socket(SS, PF_INET, SOCK_STREAM, $proto) || die "socket: $!\n";
        connect(SS, pack('S n a4 x8', AF_INET, $port, $addr)) || die "connect to $host:$port: $!\n";
        # syswrite, not print: no buffering to flush, and no select() dance
        # (on perl 5.001 select($old) did not give STDOUT back)
        my ($off, $w) = (0, 0);
        while ($off < length $req) {
            $w = syswrite(SS, $req, length($req) - $off, $off);
            die "write to $host:$port: $!\n" unless defined $w;
            $off += $w;
        }
        my $line = <SS>;
        die "no reply from $host:$port\n" unless defined $line;
        $line =~ tr/\r\n//d;
        die "not http: $line\n" unless $line =~ m!^HTTP/\S+\s+(\d+)!;
        $status = $1;
        while (defined($line = <SS>)) {
            $line =~ tr/\r\n//d;
            last unless length $line;
            $chunked = 1 if $line =~ /^transfer-encoding:\s*chunked/i;
        }
        if ($cb && $status == 200) {
            while (defined($line = <SS>)) {
                $line =~ tr/\r//d;
                next if $chunked && $line =~ /^[0-9a-fA-F]+\n?$/;
                chomp $line;
                next unless length $line;
                &$cb($line);
            }
        } else {
            local $/;
            $out = <SS>;
            $out = '' unless defined $out;
            $out = dechunk($out) if $chunked;
        }
        close SS;
    };
    alarm(0);
    if ($@) {
        $err = $@;
        chomp $err;
        $err = "no answer from $host:$port within $cfg{timeout}s" if $http_timed_out;
    }
    return ($status, $out, $err);
}

sub dechunk {
    my ($in) = @_;
    my ($out, $n, $nl) = ('', 0, 0);
    while (length $in) {
        $nl = index($in, "\n");
        last if $nl < 0;
        my $sz = substr($in, 0, $nl);
        $sz =~ s/;.*//;
        $sz =~ tr/\r//d;
        last unless $sz =~ /^[0-9a-fA-F]+$/;
        $n = hex($sz);
        last if $n == 0;
        $out .= substr($in, $nl + 1, $n);
        $in = substr($in, $nl + 1 + $n);
        $in =~ s/^\r?\n//;
    }
    return $out;
}

# ------------------------------------------------------------- provider --
# chat(system, messages, token_cb) -> (text, error). with ollama the reply
# streams and token_cb sees each piece as it lands.
sub chat {
    my ($system, $msgs, $tokcb) = @_;
    return chat_openai($system, $msgs) if $cfg{provider} =~ /^openai/;
    return chat_ollama($system, $msgs, $tokcb);
}

my ($stream_text, $stream_err, $stream_cb);
sub ollama_line {
    my ($line) = @_;
    my ($d, $e) = json_dec($line);
    if ($e || ref($d) ne 'HASH') { return }     # a partial line: ignore
    if (defined $d->{error}) { $stream_err = "ollama error: $d->{error}"; return }
    my $piece;
    $piece = $d->{message}{content} if ref($d->{message}) eq 'HASH';
    $piece = $d->{response} unless defined $piece;
    if (defined $piece && length $piece) {
        $stream_text .= $piece;
        &$stream_cb($piece) if $stream_cb;
    }
}

sub chat_ollama {
    my ($system, $msgs, $tokcb) = @_;
    my $base = $cfg{base_url};
    $base =~ s!/+$!!;
    $base =~ s!/v1$!!;
    my %options = (temperature => \'0.2');
    $options{think} = \($cfg{thinking} eq '1' ? 'true' : 'false') if $cfg{thinking} =~ /^[01]$/;
    # /api/chat has no top-level system field (that is /api/generate): the
    # prompt goes in as the first message, or the model never learns it
    # has tools and answers like a chatbot
    my %payload = (
        model    => $cfg{model},
        messages => [ { role => 'system', content => $system },
                      map { { role => $_->{role}, content => $_->{content} } } @$msgs ],
        stream   => \'true',
        options  => \%options,
    );
    $stream_text = '';
    $stream_err  = '';
    $stream_cb   = $tokcb;
    my ($st, $body, $err) = http_req('POST', "$base/api/chat", json_enc(\%payload), \&ollama_line);
    return (undef, $err) if $err;
    return (undef, $stream_err) if $stream_err;
    if ($st != 200) {
        my ($d, $e) = json_dec($body);
        my $m = (!$e && ref($d) eq 'HASH' && defined $d->{error}) ? $d->{error} : $body;
        $m = substr($m, 0, 300);
        return (undef, "ollama at $base answered http $st: $m");
    }
    return ($stream_text, undef);
}

sub chat_openai {
    my ($system, $msgs) = @_;
    my $base = $cfg{base_url};
    $base =~ s!/+$!!;
    $base .= '/v1' unless $base =~ m!/v1$!;
    my @m = ({ role => 'system', content => $system });
    my $x;
    for $x (@$msgs) { push @m, { role => $x->{role}, content => $x->{content} } }
    my %payload = (
        model    => $cfg{model},
        messages => \@m,
        stream   => \'false',
        temperature => \'0.2',
    );
    my ($st, $body, $err) = http_req('POST', "$base/chat/completions", json_enc(\%payload), undef);
    return (undef, $err) if $err;
    my ($d, $e) = json_dec($body);
    if ($st != 200) {
        my $m = (!$e && ref($d) eq 'HASH' && ref($d->{error}) eq 'HASH') ? $d->{error}{message} : $body;
        $m = substr($m, 0, 300);
        return (undef, "$base answered http $st: $m");
    }
    return (undef, "bad json from $base: $e") if $e;
    return (undef, "error from $base: " . (ref($d->{error}) ? $d->{error}{message} : $d->{error}))
        if ref($d) eq 'HASH' && defined $d->{error};
    my $ch = (ref($d) eq 'HASH' && ref($d->{choices}) eq 'ARRAY') ? $d->{choices}[0] : undef;
    return (undef, "no choices in the reply from $base") unless ref($ch) eq 'HASH';
    my $msg = $ch->{message};
    my $text = ref($msg) eq 'HASH' ? $msg->{content} : $ch->{text};
    $text = '' unless defined $text;
    # native function calling: turn it into our fenced form
    if (ref($msg) eq 'HASH' && ref($msg->{tool_calls}) eq 'ARRAY') {
        my $tc;
        for $tc (@{ $msg->{tool_calls} }) {
            next unless ref($tc) eq 'HASH' && ref($tc->{function}) eq 'HASH';
            my $args = $tc->{function}{arguments};
            $args = json_enc($args) if ref $args;
            $args = '{}' unless defined $args && length $args;
            $text .= "\n```tool\n{\"tool\":" . json_str($tc->{function}{name})
                  . ",\"args\":$args}\n```\n";
        }
    }
    return ($text, undef);
}

sub list_models {
    my $base = $cfg{base_url};
    $base =~ s!/+$!!;
    my ($url, $st, $body, $err, $d, $e, @names, $m);
    if ($cfg{provider} =~ /^openai/) {
        $base .= '/v1' unless $base =~ m!/v1$!;
        $url = "$base/models";
    } else {
        $base =~ s!/v1$!!;
        $url = "$base/api/tags";
    }
    ($st, $body, $err) = http_req('GET', $url, undef, undef);
    return (undef, $err) if $err;
    return (undef, "$url answered http $st") if $st != 200;
    ($d, $e) = json_dec($body);
    return (undef, "bad json from $url: $e") if $e;
    my $list = ref($d) eq 'HASH' ? ($d->{models} || $d->{data}) : undef;
    return (undef, "no model list in the reply from $url") unless ref($list) eq 'ARRAY';
    for $m (@$list) {
        next unless ref($m) eq 'HASH';
        push @names, defined $m->{name} ? $m->{name} : $m->{id};
    }
    return (\@names, undef);
}

# ------------------------------------------------------------- protocol --
# the model's tool calls: one JSON object per fenced block. lenient about
# the fence tag (tool, json, none) and about the shape of the object.
sub parse_calls {
    my ($text) = @_;
    my (@calls, @lines, $l, $in, $buf, $tag);
    @lines = split(/\n/, $text);
    $in = 0;
    for $l (@lines) {
        if (!$in && $l =~ /^\s*(?:```+|~~~+)\s*([A-Za-z0-9_+-]*)\s*$/) {
            $tag = lc($1);
            next if $tag =~ /^(?:result|results)$/;
            $in = 1; $buf = '';
            next;
        }
        if ($in && $l =~ /^\s*(?:```+|~~~+)\s*$/) {
            $in = 0;
            push @calls, @{ calls_from_block($buf) };
            next;
        }
        $buf .= "$l\n" if $in;
    }
    push @calls, @{ calls_from_block($buf) } if $in;     # unterminated fence
    # a bare top-level {"tool":...} with no fence at all
    if (!@calls && $text =~ /(\{\s*"(?:tool|name|command)"\s*:.*\})/s) {
        push @calls, @{ calls_from_block($1) };
    }
    # a reply that is nothing but one command in backticks (`uname -a`):
    # a small model proposing a command. it still goes through approval.
    if (!@calls && $text =~ /^\s*`([^`\n]+)`\s*$/) {
        push @calls, { tool => 'bash', args => { command => $1 } };
    }
    return \@calls;
}

sub calls_from_block {
    my ($buf) = @_;
    my @out;
    return \@out unless defined $buf && $buf =~ /\S/;
    my ($d, $e) = json_dec($buf);
    if ($e) {
        # several objects, one per line?
        my ($l, $ok);
        for $l (split(/\n/, $buf)) {
            next unless $l =~ /^\s*\{/;
            ($d, $e) = json_dec($l);
            next if $e || ref($d) ne 'HASH';
            push @out, normalize($d);
            $ok = 1;
        }
        return \@out if $ok;
        return \@out unless $buf =~ /^\s*\{/;
        push @out, { tool => '', args => {}, error => "bad JSON in tool block: $e" };
        return \@out;
    }
    if (ref($d) eq 'ARRAY') {
        my $x;
        for $x (@$d) { push @out, normalize($x) if ref($x) eq 'HASH' }
    } elsif (ref($d) eq 'HASH') {
        push @out, normalize($d);
    }
    return \@out;
}

sub normalize {
    my ($h) = @_;
    my %c = (tool => '', args => {});
    my $k;
    for $k ('tool', 'name', 'action', 'function', 'fn') {
        if (defined $h->{$k} && !ref $h->{$k}) { $c{tool} = lc($h->{$k}); last }
    }
    for $k ('args', 'arguments', 'input', 'params', 'parameters') {
        if (ref($h->{$k}) eq 'HASH') { $c{args} = $h->{$k}; last }
        if (defined $h->{$k} && !ref $h->{$k} && length $h->{$k}) {
            my ($a2, $e2) = json_dec($h->{$k});
            if (!$e2 && ref($a2) eq 'HASH') { $c{args} = $a2; last }
        }
    }
    if (ref($h->{function}) eq 'HASH') {
        my $f = $h->{function};
        $c{tool} = lc($f->{name}) if !length $c{tool} && defined $f->{name};
        if (!keys %{ $c{args} }) {
            if (ref($f->{arguments}) eq 'HASH') { $c{args} = $f->{arguments} }
            elsif (defined $f->{arguments}) {
                my ($a2, $e2) = json_dec($f->{arguments});
                $c{args} = $a2 if !$e2 && ref($a2) eq 'HASH';
            }
        }
    }
    if (!keys %{ $c{args} }) {
        my %flat;
        for $k (keys %$h) {
            next if $k =~ /^(?:tool|name|action|function|fn|args|arguments|input|params|parameters)$/;
            $flat{$k} = $h->{$k};
        }
        $c{args} = \%flat if %flat;
    }
    if (!length $c{tool} && defined $h->{command} && !ref $h->{command}) {
        $c{tool} = 'bash';
        $c{args} = { command => $h->{command} };
    }
    return \%c;
}

sub results_block {
    my ($results) = @_;
    my ($r, @lines);
    for $r (@$results) {
        push @lines, json_enc({
            tool   => $r->{tool},
            ok     => \($r->{ok} ? '1' : '0'),
            output => (defined $r->{output} ? $r->{output} : ''),
        });
    }
    return "```result\n" . join("\n", @lines) . "\n```";
}

# the prose of a reply: everything outside tool/result fences
sub visible {
    my ($text) = @_;
    my ($l, $in, @out);
    $in = 0;
    for $l (split(/\n/, $text)) {
        if (!$in && $l =~ /^\s*(?:```+|~~~+)\s*(tool|json|oldagent|oa|result)?\s*$/i) {
            $in = 1; next;
        }
        if ($in && $l =~ /^\s*(?:```+|~~~+)\s*$/) { $in = 0; next }
        push @out, $l unless $in;
    }
    my $s = join("\n", @out);
    $s =~ s/^\s+//;
    $s =~ s/\s+$//;
    return $s;
}

sub looks_like_intent {
    my ($text) = @_;
    return 0 unless defined $text;
    return 1 if $text =~ /\b(?:let me(?! know)|let's|i'll(?! be\b)|i will(?! be\b)|i am going to|i'm going to|i need to|i should|first,? i|next,? i|now i)\b/i;
    return 0;
}

# ---------------------------------------------------------------- tools --
my $MAX_OUT = 6000;      # chars of tool output the model gets to see

sub tool_spec {
    return <<'SPEC';
Tools you can use (one JSON object per ```tool block):
  read   {"tool":"read","args":{path [from] [lines]}}
         read a text file; from = first line (1-based), lines = how many
  write  {"tool":"write","args":{path content [mode]}}
         create or overwrite a file, mode=append to add to the end
  edit   {"tool":"edit","args":{path find replace [all]}}
         replace the exact text find with replace (all=1 for every match)
  list   {"tool":"list","args":{path [glob] [limit]}}
         list a directory, optional glob like *.c
  bash   {"tool":"bash","args":{command [timeout]}}
         run a shell command, stdout+stderr merged, default timeout 30s
  done   {"tool":"done","args":{summary}}
         call this when the task is finished
SPEC
}

sub arg_path {
    my ($args) = @_;
    my $p = $args->{path};
    $p = $args->{file}     if !defined $p && defined $args->{file};
    $p = $args->{filename} if !defined $p && defined $args->{filename};
    return undef unless defined $p && length $p;
    $p =~ s!^~/!$ENV{HOME}/! if defined $ENV{HOME};
    return $p;
}

sub clip_out {
    my ($s) = @_;
    return $s unless length $s > $MAX_OUT;
    my $n = length($s) - $MAX_OUT;
    return substr($s, 0, $MAX_OUT) . "\n[... clipped $n chars ...]";
}

sub tool_read {
    my ($args) = @_;
    my $p = arg_path($args);
    return { ok => 0, output => 'missing "path" argument' } unless defined $p;
    return { ok => 0, output => "$p: not a file" } unless -f $p;
    local *FH;
    open(FH, "<$p") || return { ok => 0, output => "$p: $!" };
    my @l = <FH>;
    close FH;
    my $from = (defined $args->{from} && $args->{from} =~ /^\d+$/) ? $args->{from} : 1;
    $from = 1 if $from < 1;
    my $n = (defined $args->{lines} && $args->{lines} =~ /^\d+$/) ? $args->{lines} : 200;
    my $last = $from - 1 + $n;
    $last = @l if $last > @l;
    my ($i, $out);
    $out = '';
    for $i (($from - 1) .. ($last - 1)) { $out .= sprintf("%5d  %s", $i + 1, $l[$i]) }
    $out .= "[" . (scalar(@l) - $last) . " more lines]\n" if $last < @l;
    $out = "(empty file)" unless length $out;
    return { ok => 1, output => clip_out($out) };
}

sub tool_write {
    my ($args) = @_;
    my $p = arg_path($args);
    return { ok => 0, output => 'missing "path" argument' } unless defined $p;
    my $c = $args->{content};
    $c = $args->{text} if !defined $c && defined $args->{text};
    $c = '' unless defined $c;
    my $mode = (defined $args->{mode} && $args->{mode} eq 'append') ? '>>' : '>';
    local *FH;
    open(FH, "$mode$p") || return { ok => 0, output => "$p: $!" };
    print FH $c;
    close FH;
    return { ok => 1, output => ($mode eq '>>' ? 'appended ' : 'wrote ') . length($c) . " chars to $p" };
}

sub tool_edit {
    my ($args) = @_;
    my $p = arg_path($args);
    return { ok => 0, output => 'missing "path" argument' } unless defined $p;
    return { ok => 0, output => 'missing "find" argument' } unless defined $args->{find} && length $args->{find};
    my $rep = defined $args->{replace} ? $args->{replace} : '';
    local *FH;
    open(FH, "<$p") || return { ok => 0, output => "$p: $!" };
    my $data = do { local $/; <FH> };
    close FH;
    $data = '' unless defined $data;
    my ($pos, $n, $f) = (0, 0, $args->{find});
    while (($pos = index($data, $f, $pos)) >= 0) {
        substr($data, $pos, length $f) = $rep;
        $pos += length $rep;
        $n++;
        last unless $args->{all};
    }
    return { ok => 0, output => "text not found in $p" } unless $n;
    open(FH, ">$p") || return { ok => 0, output => "$p: $!" };
    print FH $data;
    close FH;
    return { ok => 1, output => "replaced $n occurrence" . ($n == 1 ? '' : 's') . " in $p" };
}

sub tool_list {
    my ($args) = @_;
    my $p = arg_path($args);
    $p = '.' unless defined $p;
    return { ok => 0, output => "$p: not a directory" } unless -d $p;
    local *DH;
    opendir(DH, $p) || return { ok => 0, output => "$p: $!" };
    my @f = sort grep { $_ ne '.' && $_ ne '..' } readdir(DH);
    closedir DH;
    if (defined $args->{glob} && length $args->{glob}) {
        my $re = quotemeta($args->{glob});
        $re =~ s/\\\*/.*/g;
        $re =~ s/\\\?/./g;
        @f = grep { /^$re$/ } @f;
    }
    my $limit = (defined $args->{limit} && $args->{limit} =~ /^\d+$/) ? $args->{limit} : 200;
    my ($f, $out, $n);
    $out = '';
    $n = 0;
    for $f (@f) {
        last if $n++ >= $limit;
        my $full = "$p/$f";
        if (-d $full) { $out .= "$f/\n" }
        else { $out .= sprintf("%-32s %8d\n", $f, (-s $full) || 0) }
    }
    $out .= "[" . (@f - $limit) . " more entries]\n" if @f > $limit;
    $out = '(empty directory)' unless length $out;
    return { ok => 1, output => clip_out($out) };
}

sub cmd_timeout {
    $cmd_killed = 1;
    kill('TERM', $cmd_pid) if $cmd_pid;
}

sub tool_bash {
    my ($args) = @_;
    my $cmd = $args->{cmd};
    $cmd = $args->{command} if !defined $cmd && defined $args->{command};
    $cmd = $args->{script}  if !defined $cmd && defined $args->{script};
    return { ok => 0, output => 'missing "command" argument' } unless defined $cmd && length $cmd;
    my $to = (defined $args->{timeout} && $args->{timeout} =~ /^\d+$/) ? $args->{timeout} : 30;
    $to = 10 if $to < 1;
    $to = 600 if $to > 600;
    my $ok = approve($cmd);
    return { ok => 0, output => $ok } if $ok ne 'yes';
    local *CM;
    $cmd_killed = 0;
    local $SIG{ALRM} = 'cmd_timeout';
    $cmd_pid = open(CM, "($cmd) 2>&1 |");
    return { ok => 0, output => "cannot run: $!" } unless $cmd_pid;
    alarm($to);
    my $out = '';
    my $l;
    while (defined($l = <CM>)) { $out .= $l }
    alarm(0);
    close CM;
    my $st = $?;
    $cmd_pid = 0;
    $out =~ s/\s+$//;
    $out = '(no output)' unless length $out;
    my $note = '';
    if ($cmd_killed)      { $note = "\n[command timed out after ${to}s and was killed]" }
    elsif ($st & 127)     { $note = "\n[killed by signal " . ($st & 127) . "]" }
    elsif ($st >> 8)      { $note = "\n[exit status " . ($st >> 8) . "]" }
    return { ok => ($st == 0 && !$cmd_killed) ? 1 : 0, output => clip_out($out) . $note };
}

# bash approval: ask on the tty, auto, or off. 'yes' or the refusal text.
sub approve {
    my ($cmd) = @_;
    return 'yes' if $cfg{approve} eq 'auto';
    return 'bash is switched off (/approve ask to turn it on)' if $cfg{approve} eq 'off';
    return 'no terminal to ask for approval on; run with -y to allow commands' unless -t STDIN;
    print "\n  run: $cmd\n  allow? [y]es / [n]o / [a]lways: ";
    my $ans = <STDIN>;
    print "\n";
    return 'the human declined to run this command' unless defined $ans;
    $ans =~ s/^\s+//;
    if ($ans =~ /^a/i) { $cfg{approve} = 'auto'; return 'yes' }
    return 'yes' if $ans =~ /^y/i;
    return 'the human declined to run this command';
}

my %TOOLS = (
    read  => \&tool_read,
    write => \&tool_write,
    edit  => \&tool_edit,
    list  => \&tool_list,
    bash  => \&tool_bash,
    sh    => \&tool_bash,
    shell => \&tool_bash,
    exec  => \&tool_bash,
    run   => \&tool_bash,
    ls    => \&tool_list,
    cat   => \&tool_read,
);

# ---------------------------------------------------------------- agent --
# the first PATH entry that holds an executable of that name (asking the
# shell makes it print "not found" on its own stderr, past any redirect)
sub in_path {
    my ($name) = @_;
    my $d;
    for $d (split(/:/, defined $ENV{PATH} ? $ENV{PATH} : '/bin:/usr/bin')) {
        next unless length $d;
        return "$d/$name" if -x "$d/$name" && !-d "$d/$name";
    }
    return '';
}

sub system_prompt {
    my $host = $Config::Config{osname};
    $host = 'unknown' unless defined $host && length $host;
    my $hn = `hostname 2>/dev/null`;
    $hn = '' unless defined $hn;
    $hn =~ s/\s+//g;
    $host = "$hn ($host $Config::Config{archname})" if length $hn;
    my $cwd = `pwd`;
    $cwd =~ s/\s+$// if defined $cwd;
    # what the box says about itself: uname where there is one, hostinfo
    # on a NeXT (which has no uname at all)
    my $os = '';
    my $un = in_path('uname');
    $un = in_path('hostinfo') unless $un;
    $os = `$un -a 2>/dev/null` if $un && $un =~ /uname$/;
    $os = `$un 2>/dev/null`    if $un && $un =~ /hostinfo$/;
    $os = '' unless defined $os;
    $os =~ s/\s+/ /g;
    $os =~ s/^ //;
    $os = substr($os, 0, 240);
    my $s = "You are oldagent $VERSION (oa1, the one-file edition), an agent "
          . "running on a real computer. When the human asks for something to be "
          . "done on this machine, you do it by emitting tool calls and the system "
          . "executes them for you. When the human is just talking to you, answer "
          . "in plain prose - no tool block needed. Be brief and concrete. Prefer "
          . "short commands and small edits.\n\n";
    $s .= "Environment\n  host: $host\n";
    $s .= "  os:   $os\n" if length $os;
    $s .= "  perl: $]\n  cwd:  $cwd\n\n";
    if ($cfg{tools}) {
        $s .= "How to act\n"
            . "You act by emitting a fenced block tagged tool containing one JSON "
            . "object; the system runs it and returns the result. Never say you "
            . "cannot run something - emit the tool block instead. Questions about "
            . "this machine - what it is, what is installed, what is wrong - are "
            . "answered by running a command and reading the result, not from "
            . "memory. Execution stops "
            . "at the end of your reply; results arrive in the next message inside a "
            . "```result block as one JSON object per line.\n\n"
            . "  ```tool\n  {\"tool\":\"read\",\"args\":{\"path\":\"notes.txt\"}}\n  ```\n\n"
            . tool_spec()
            . "\nRules\n"
            . "  - One JSON object per tool block. No comments inside the JSON.\n"
            . "  - Never invent or predict a result. Ask, stop, and wait.\n"
            . "  - Read before you write. Use edit for small changes, write for new files.\n"
            . "  - Keep output small: read with from/lines, list with glob.\n"
            . "  - When a task that used tools is finished, END your final reply with a done block: a single fenced tool block containing {\"tool\":\"done\",\"args\":{\"summary\":\"one paragraph\"}}.\n"
            . "  - Plain prose outside tool blocks is shown to the human. A conversational reply needs no tool block and no done block.\n"
            . "  - Only act on what the human asked for in this conversation. Do not go looking for other work.\n";
    } else {
        $s .= "You have no tools in this session. Answer in plain text only.\n";
    }
    $s .= "\n$cfg{system_extra}\n" if length $cfg{system_extra};
    return $s;
}

sub say { print @_ unless $cfg{quiet} }

# the model writes utf-8; a 1990s terminal shows an em dash as "b" (its
# first byte). with ascii on, the common punctuation becomes its ascii
# cousin and anything else multi-byte becomes "?".
sub fold {
    my ($s) = @_;
    return $s unless $cfg{ascii};
    $s =~ s/\xe2\x80[\x93\x94\x95]/-/g;          # en/em/horizontal dash
    $s =~ s/\xe2\x80[\x98\x99\x9b]/'/g;          # single quotes
    $s =~ s/\xe2\x80[\x9c\x9d\x9f]/"/g;          # double quotes
    $s =~ s/\xe2\x80\xa6/.../g;                 # ellipsis
    $s =~ s/\xe2\x80[\xa2\xa3]/*/g;             # bullets
    $s =~ s/\xe2\x86\x92/->/g;                  # arrow
    $s =~ s/\xc2\xa0/ /g;                       # nbsp
    $s =~ s/\xc3\x97/x/g;                       # multiplication sign
    $s =~ s/[\xc0-\xf7][\x80-\xbf]+/?/g;         # anything else multi-byte
    $s =~ s/[\x80-\xbf]/?/g;                     # stray continuation bytes
    return $s;
}

# bytes at the end of $s that start a utf-8 sequence not yet complete
# (a token boundary can fall inside one): hold them for the next piece
sub utf8_tail {
    my ($s) = @_;
    my ($i, $c, $need);
    for $i (1 .. 3) {
        last if $i > length $s;
        $c = ord(substr($s, -$i, 1));
        next if $c >= 0x80 && $c < 0xc0;           # continuation byte: look further back
        last if $c < 0x80;
        $need = $c >= 0xf0 ? 4 : $c >= 0xe0 ? 3 : 2;
        return $i if $i < $need;
        last;
    }
    return 0;
}

# streamed pieces go to the screen a line at a time, and lines inside a
# tool/result fence (the JSON the model emits for the system) stay off it.
# a partial line is shown as it grows unless it could be a fence opener.
my ($streamed, $tok_line, $tok_in_fence, $tok_shown);
sub show_token {
    $streamed = 1;
    $tok_line .= $_[0];
    my $nl;
    while (($nl = index($tok_line, "\n")) >= 0) {
        my $l = substr($tok_line, 0, $nl);
        $tok_line = substr($tok_line, $nl + 1);
        if (!$tok_in_fence && $l =~ /^\s*(?:```+|~~~+)\s*[A-Za-z0-9_+-]*\s*$/) { $tok_in_fence = 1; $tok_shown = 0; next }
        if ($tok_in_fence && $l =~ /^\s*(?:```+|~~~+)\s*$/) { $tok_in_fence = 0; next }
        next if $tok_in_fence;
        print fold(substr($l, $tok_shown)), "\n";
        $tok_shown = 0;
    }
    # hold a partial line back only while it could still turn into a fence
    return if $tok_in_fence || $tok_line =~ /^\s*(?:`{1,2}|~{1,2})$/ || $tok_line =~ /^\s*(?:```|~~~)/;
    my $upto = length($tok_line) - utf8_tail($tok_line);
    return if $upto <= $tok_shown;
    print fold(substr($tok_line, $tok_shown, $upto - $tok_shown));
    $tok_shown = $upto;
}
sub show_flush {
    if (!$tok_in_fence && $tok_line !~ /^\s*(?:```|~~~)/ && length $tok_line) {
        print fold(substr($tok_line, $tok_shown)), "\n";
    }
    ($tok_line, $tok_in_fence, $tok_shown) = ("", 0, 0);
}

# one human message, run to completion. returns the final text.
sub turn {
    my ($text) = @_;
    push @hist, { role => 'user', content => $text };
    my ($i, $reply, $err, $calls, $c, $final, $nudged);
    $final = '';
    $nudged = 0;
    for $i (1 .. $cfg{turns}) {
        $streamed = 0;
        ($tok_line, $tok_in_fence, $tok_shown) = ("", 0, 0);
        say("\n") if $i > 1;
        print STDERR "--- system prompt:\n", system_prompt(), "---\n" if $cfg{debug} && $i == 1 && @hist == 1;
        ($reply, $err) = chat(system_prompt(), \@hist, ($cfg{quiet} ? undef : \&show_token));
        if ($err) {
            print "\nerror: $err\n";
            pop @hist if $i == 1 && !$nudged;   # the question did not land
            return undef;
        }
        $reply = '' unless defined $reply;
        push @hist, { role => 'assistant', content => $reply };
        my $prose = visible($reply);
        show_flush() if $streamed;
        print STDERR "--- reply $i (", length($reply), " chars):\n$reply\n---\n" if $cfg{debug};
        print fold($prose), "\n" if !$streamed && length $prose;
        $final = $prose if length $prose;
        $calls = $cfg{tools} ? parse_calls($reply) : [];
        if (!@$calls) {
            if (!$nudged && $cfg{tools} && looks_like_intent($prose)) {
                $nudged = 1;
                push @hist, { role => 'user', content =>
                    "No tool call was emitted, so nothing was executed. If you meant to act, emit the tool block now; if the task is done, end with a done block." };
                next;
            }
            last;
        }
        my @results;
        for $c (@$calls) {
            if ($c->{tool} eq 'done') {
                my $sum = $c->{args}{summary};
                $sum = $c->{args}{message} if !defined $sum && defined $c->{args}{message};
                $final = $sum if defined $sum && length $sum;
                say("\n  [done]\n");
                print fold($sum), "\n" if $cfg{quiet} && defined $sum;
                return $final;
            }
            print STDERR "--- call: ", json_enc($c), "\n" if $cfg{debug};
            my $r = run_tool($c);
            print STDERR "--- result: ", json_enc($r), "\n" if $cfg{debug};
            push @results, $r;
            show_result($c, $r);
        }
        push @hist, { role => 'user', content => results_block(\@results) };
    }
    return $final;
}

sub run_tool {
    my ($c) = @_;
    return { tool => '?', ok => 0, output => $c->{error} } if defined $c->{error};
    my $f = $TOOLS{ $c->{tool} };
    return { tool => $c->{tool}, ok => 0, output => "unknown tool \"$c->{tool}\" (have: read write edit list bash done)" }
        unless $f;
    my $r = &$f($c->{args});
    $r->{tool} = $c->{tool};
    return $r;
}

sub show_result {
    my ($c, $r) = @_;
    return if $cfg{quiet};
    my $args = $c->{args};
    my $what = $c->{tool};
    if ($c->{tool} =~ /^(?:bash|sh|shell|exec|run)$/) {
        my $cmd = defined $args->{command} ? $args->{command} : (defined $args->{cmd} ? $args->{cmd} : '');
        $what = "bash: $cmd";
    } elsif (defined arg_path($args)) {
        $what .= " " . arg_path($args);
    }
    print "  [$what] ", ($r->{ok} ? 'ok' : 'failed'), "\n";
    # the whole result, nothing cut (the tool already clips it for the model)
    my @l = split(/\n/, $r->{output});
    my $i;
    for $i (0 .. $#l) { print "    ", fold($l[$i]), "\n" }
}

# --------------------------------------------------------------- config --
sub rc_path {
    return $cfg{rcfile} if length $cfg{rcfile};
    return $ENV{OLDAGENTRC} if defined $ENV{OLDAGENTRC} && length $ENV{OLDAGENTRC};
    my $h = defined $ENV{HOME} ? $ENV{HOME} : '.';
    return "$h/.oldagentrc";
}

sub load_rc {
    return if $cfg{noconfig};
    my $p = rc_path();
    local *RC;
    open(RC, "<$p") || return;
    my ($l, $k, $v);
    while (defined($l = <RC>)) {
        chomp $l;
        next if $l =~ /^\s*#/;
        next unless $l =~ /^([A-Za-z_][A-Za-z0-9_.-]*)\s*=\s*(.*)$/;
        ($k, $v) = ($1, $2);
        $v =~ s/\s+$//;
        $k = 'base_url' if $k eq 'base';
        $k = 'api_key'  if $k eq 'key';
        $cfg{$k} = $v if exists $cfg{$k};
    }
    close RC;
    $cfg{provider} = 'openai' if $cfg{provider} =~ /^openai/;
    $cfg{tools} = ($cfg{tools} =~ /^(?:0|off|no|false)$/i) ? 0 : 1;
}

sub save_rc {
    my ($k, $v) = @_;
    return if $cfg{noconfig};
    my $p = rc_path();
    my (@l, $l, $hit);
    local *RC;
    if (open(RC, "<$p")) { @l = <RC>; close RC }
    for $l (@l) {
        if ($l =~ /^\s*\Q$k\E\s*=/) { $l = "$k = $v\n"; $hit = 1 }
    }
    push @l, "$k = $v\n" unless $hit;
    open(RC, ">$p") || do { print "cannot write $p: $!\n"; return };
    print RC @l;
    close RC;
}

sub show_config {
    my $k;
    for $k ('provider', 'base_url', 'model', 'approve', 'tools', 'turns', 'timeout', 'thinking', 'ascii') {
        printf("  %-9s %s\n", $k, $cfg{$k});
    }
    print "  api_key   ", (length $cfg{api_key} ? '(set)' : '(none)'), "\n";
    print "  rc        ", ($cfg{noconfig} ? '(ignored)' : rc_path()), "\n";
    print "  perl      $] on $Config::Config{osname}\n";
}

