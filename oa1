# what /help prints inside a session: the commands a session actually has,
# one per line, and no command-line flags, which cannot be passed from here.
sub repl_help {
    return <<'HELP';
in the session:
  /help            this, then the settings in use
  /quit            leave (also /q, /exit)
  /model NAME      which model to talk to
  /base URL        which endpoint, http://host:port (https wants a curl or wget)
  /provider P      ollama (native /api/chat) or openai (/v1/chat/completions)
  /approve MODE    auto (the default), ask, or off - for bash commands
  /tools [on|off]  let the model read, write, edit, list and bash
  /models          what the endpoint serves
  /history         what is in context
  /clear           forget the conversation (also /reset)
  /config          the settings in use (the same list this ends with)
  /session         where this session is on disk (it is saved as you go)
  /resume FILE     pick up a saved session and keep going
  /proxy HOST:PORT an oa-proxy for web search (off to clear)
  /search Q        web search through the proxy (keenable); needs /proxy first

anything else is a message to the model. the flags are command line only:
`oa1 help` lists them.
HELP
}

sub repl {
    local $SIG{INT} = 'sig_int';   # Ctrl-C reports the session and keeps going
    session_begin();
    print "oa1 $VERSION - $cfg{provider} / $cfg{model} at $cfg{base_url}\n";
    print "session: $session_file (on disk; resumable)\n" if length $session_file;
    print "type a message; /help for commands, /quit to leave\n\n";
    my ($line, $cmd, $arg);
    while (1) {
        print "> ";
        $at_prompt = 1;
        $line = $have_tty ? <TTY> : <STDIN>;
        $at_prompt = 0;
        unless (defined $line) {
            # real EOF (Ctrl-D / a closed pipe) leaves. an interrupt at a tty
            # prompt is already reported and cleared by the handler, which is
            # still sitting under this read; only a non-tty read comes back
            # here on a signal, and that gets one report then it keeps going.
            if ($interrupted) { $interrupted = 0; print "\n"; session_end_notice(); next }
            last;
        }
        chomp $line;
        $line =~ s/^\s+//;
        $line =~ s/\s+$//;
        next unless length $line;
        if ($line =~ m!^/(\w+)\s*(.*)$!) {
            ($cmd, $arg) = ($1, $2);
            last if $cmd =~ /^(?:quit|exit|q)$/;
            if    ($cmd eq 'help') { print repl_help(); print "\nsettings in use:\n"; show_config() }
            elsif ($cmd eq 'model' && length $arg)    { $cfg{model} = $arg; save_rc('model', $arg); print "model = $arg\n" }
            elsif ($cmd eq 'base' && length $arg)     { $cfg{base_url} = $arg; save_rc('base_url', $arg); print "base_url = $arg\n" }
            elsif ($cmd eq 'provider' && length $arg) { $cfg{provider} = $arg =~ /^openai/ ? 'openai' : 'ollama'; save_rc('provider', $cfg{provider}); print "provider = $cfg{provider}\n" }
            elsif ($cmd eq 'approve' && $arg =~ /^(ask|auto|off)$/) { $cfg{approve} = $1; print "approve = $1\n" }
            elsif ($cmd eq 'tools')   { $cfg{tools} = ($arg =~ /^(?:off|0|no)$/i) ? 0 : 1; print "tools = ", ($cfg{tools} ? 'on' : 'off'), "\n" }
            elsif ($cmd eq 'clear' || $cmd eq 'reset') { @hist = (); $session_file = ''; session_begin(); print "(history cleared)", (length $session_file ? " - new session: $session_file" : ""), "\n" }
            elsif ($cmd eq 'history') { my $m; for $m (@hist) { my $t = $m->{content}; $t =~ s/\n/ /g; print "  $m->{role}: ", substr($t, 0, 70), "\n" } }
            elsif ($cmd eq 'config')  { show_config() }
            elsif ($cmd eq 'models')  { cmd_models() }
            elsif ($cmd eq 'session') { print (length $session_file ? "session: $session_file\n" : "no session file (could not create one)\n") }
            elsif ($cmd eq 'resume' && length $arg) { my $n = session_load($arg); print $n ? "resumed $n messages - continuing\n" : "(nothing loaded from $arg)\n" }
            elsif ($cmd eq 'proxy') {
                if ($arg eq 'off' || $arg eq 'clear' || $arg eq 'none') {
                    $cfg{proxy} = ''; save_rc('proxy', ''); print "proxy cleared\n";
                } elsif (length $arg) {
                    my $u = $arg;
                    $u =~ s{^https?://}{}; $u =~ s{/.*$}{};
                    $cfg{proxy} = $u; save_rc('proxy', $u); print "proxy = $u  (for /search)\n";
                } else {
                    print "proxy = ", (length $cfg{proxy} ? $cfg{proxy} : "(none)"), "\n";
                }
            }
            elsif ($cmd eq 'search' || $cmd eq 'web') { search_via_proxy($arg); }
            else { print "unknown command /$cmd (try /help)\n" }
            next;
        }
        turn($line);
        print "\n";
        # Ctrl-C during the turn: the reply unwound and came back; report the
        # session and keep the prompt (do not lose the whole run to a stray ^C).
        if ($interrupted) { $interrupted = 0; session_end_notice() }
    }
    print "\n";
    session_end_notice();
}

# is the configured model in the list? (perl 5.001 cannot parse grep({...} LIST))
sub model_known {
    my ($names) = @_;
    my $n;
    for $n (@$names) { return 1 if $n eq $cfg{model} }
    return 0;
}

sub cmd_doctor {
    print "oa1 $VERSION - the one-file edition (perl 5.001 and up)\n";
    show_config();
    print "  shell     ", (in_path('sh') ? in_path('sh') : '(no sh: the bash tool cannot run)'), "\n";
    print "  uname     ", (in_path('uname') || in_path('hostinfo') || '(neither uname nor hostinfo)'), "\n";
    print "  tty       ", (-t STDIN ? 'yes' : 'no (bash approval needs one; -y to skip it)'), "\n";
    my $tls = https_kind();
    print "  https     ", ($tls eq 'none'
        ? 'no TLS in this perl and no curl or wget here: http only (oa-proxy bridges it)'
        : "borrowed from $tls at " . in_path($tls) . ' (the reply arrives whole, not streamed)'), "\n";
    my ($names, $err) = list_models();
    if ($err) { print "  endpoint  $cfg{base_url}: $err\n"; return 1 }
    print "  endpoint  $cfg{base_url}: ", scalar(@$names), " model(s)",
          (length $cfg{model} ? (model_known($names) ? ", $cfg{model} is one of them" : ", but $cfg{model} is NOT one of them") : ', pick one with --model'), "\n";
    return 0;
}

# the full, multi-file agent (oa), when this perl can compile the tree.
# oa1 is the one-file edition for a perl too old for that; on a modern box
# `oa1 oa` hands over to the full thing instead of staying in the minimal one.
sub cmd_oa {
    my ($rest) = @_;
    # the full agent is already handing us back (its perl is too old); running
    # it again would loop. oa1 is the edition for this box, so stop here.
    if ($ENV{OA1_HANDOFF}) {
        print STDERR "oa1 oa: the full agent is not for this perl ($]); oa1 is the edition here\n";
        return 0;
    }
    my $perl_ok = $] >= 5.006;
    my $full = '';
    # an oa next to this oa1 (the normal install layout) beats one on the path
    my $self = $0;
    my $t = -l $self ? readlink($self) : undef;
    my $dir;
    if (defined $t) {
        $dir = $self;
        $dir =~ s{[^/]*$}{};
        $t = ($t =~ m{^/}) ? $t : "$dir$t";
        $self = $t;
    }
    $dir = $self;
    $dir =~ s{[^/]*$}{};
    $dir = './' unless length $dir;
    if (-f "$dir/oa") {
        $full = "$dir/oa";
    } else {
        $full = in_path('oa');
    }
    if (!$perl_ok || !length $full) {
        my $why = !$perl_ok
            ? "this perl ($]) is too old for the full agent (needs 5.006); oa1 is the whole edition here"
            : "no full agent (oa) next to this oa1 or on the path; oa1 is the whole edition here";
        print STDERR "oa1 oa: $why\n";
        return 0;
    }
    print STDERR "oa1 oa: running the full agent at $full\n";
    $ENV{OA1_HANDOFF} = 1;  # if the full agent hands back to oa1, do not hand over again
    exec($^X, $full, @$rest);
    print STDERR "oa1 oa: could not start $full: $!\n";
    return 1;
}

sub cmd_models {
    my ($names, $err) = list_models();
    if ($err) { print "error: $err\n"; return 1 }
    print "models at $cfg{base_url}:\n";
    my $n;
    for $n (@$names) { print "  $n\n" }
    print "  (none)\n" unless @$names;
    return 0;
}

# web search through an oa-proxy: the proxy (a modern box) does the keenable
# https call; oa1 only needs plain http, which http_req already has. the
# dialect stays 5.000: no our, no foreach my, no qr//, no $f->().
sub search_via_proxy {
    my ($query) = @_;
    my $proxy = $cfg{proxy};
    if (!length $proxy) {
        print "no proxy set:  /proxy 127.0.0.1:8080   (an oa-proxy, for web search)\n";
        return 1;
    }
    if (!length $query) {
        print "usage:  /search <what to find>\n";
        return 2;
    }
    my $body = json_enc({ query => $query, max_results => 6 });
    # http://host:port/search; http_req handles the connect + alarm + close.
    # the proxy takes no auth, and http_req only adds a Bearer if api_key is set.
    my ($st, $out, $err) = http_req('POST', "http://$proxy/search", $body, undef);
    if (defined $err && $err ne '') {
        print "search: $err\n";
        return 1;
    }
    my ($d, $je) = json_dec($out);
    if ($je || !ref($d)) {
        my $m = (ref($d) eq 'HASH' && length $d->{error}) ? $d->{error} : ($je || "bad reply from the proxy (http $st)");
        print "search: $m\n";
        return 1;
    }
    my $res = $d->{results};
    my $n = 0;
    my $i = 0;
    my $r;
    if (ref($res) eq 'ARRAY') {
        for $r (@$res) {
            next unless ref($r) eq 'HASH';
            $i++;
            $n++;
            my $title = defined $r->{title} ? $r->{title} : '';
            my $url   = defined $r->{url}   ? $r->{url}   : '';
            my $snip  = defined $r->{snippet} ? $r->{snippet} : '';
            print $i . ". $title\n";
            print "   $url\n" if length $url;
            if (length $snip) {
                $snip =~ s/\s+/ /g;
                $snip = substr($snip, 0, 400) . '...' if length($snip) > 400;
                print "   $snip\n";
            }
        }
    }
    if (!$n) { print "no results for: $query\n"; return 1 }
    my $k = $d->{keyless} ? 'keyless' : 'keyed';
    print "($n result(s) via $proxy, keenable $k)\n";
    return 0;
}

sub main {
    my (@args, $opt, $cmd, $text);
    @args = @ARGV;
    my @rest;
    # `oa1 oa [args...]` runs the full, multi-file agent. everything after the
    # first `oa` belongs to it (its --version, its --model, ...), so oa1's flag
    # parser must not eat those. oa1-level flags before `oa` are still honoured.
    {
        my @pass;        # the args that go to the full agent
        my @pre;         # oa1-level tokens before `oa`
        my $seen_oa;
        my $tok;
        for $tok (@args) {
            if ($seen_oa) { push @pass, $tok; next }
            $seen_oa = 1, next if $tok eq 'oa';
            push @pre, $tok;
        }
        if ($seen_oa) {
            # honour the rc flags that sat before `oa`, then hand over
            my $p;
            while (@pre) {
                $p = shift @pre;
                if ($p eq '--config') { $cfg{rcfile} = shift @pre; next }
                if ($p eq '--no-config') { $cfg{noconfig} = 1; next }
            }
            load_rc();
            return cmd_oa(\@pass);
        }
    }
    # the rc first, then flags on top of it
    while (@args) {
        $opt = shift @args;
        if    ($opt eq '--config')    { $cfg{rcfile} = shift @args }
        elsif ($opt eq '--no-config') { $cfg{noconfig} = 1 }
        else { push @rest, $opt }
    }
    load_rc();
    @args = @rest; @rest = ();
    while (@args) {
        $opt = shift @args;
        if    ($opt eq '--provider')  { $cfg{provider} = shift @args; $cfg{provider} = 'openai' if $cfg{provider} =~ /^openai/ }
        elsif ($opt eq '--base-url' || $opt eq '--base') { $cfg{base_url} = shift @args }
        elsif ($opt eq '--model')     { $cfg{model} = shift @args }
        elsif ($opt eq '--key')       { $cfg{api_key} = shift @args }
        elsif ($opt eq '--turns')     { $cfg{turns} = shift @args }
        elsif ($opt eq '--timeout')   { $cfg{timeout} = shift @args }
        elsif ($opt eq '-y' || $opt eq '--yes') { $cfg{approve} = 'auto' }
        elsif ($opt eq '--no-tools')  { $cfg{tools} = 0 }
        elsif ($opt eq '-q' || $opt eq '--quiet') { $cfg{quiet} = 1 }
        elsif ($opt eq '--debug')     { $cfg{debug} = 1 }
        elsif ($opt eq '--ascii')     { $cfg{ascii} = 1 }
        elsif ($opt eq '--utf8')      { $cfg{ascii} = 0 }
        elsif ($opt eq '-p')          { $cmd = 'ask'; push @rest, shift @args }
        elsif ($opt eq '--cd')        { my $d = shift @args; chdir($d) || die "cannot cd to $d: $!\n" }
        elsif ($opt eq '--proxy')     { my $u = shift @args; $u =~ s{^https?://}{}; $u =~ s{/.*$}{}; $cfg{proxy} = $u; save_rc('proxy', $u) unless $cfg{quiet} }
        elsif ($opt eq '-h' || $opt eq '--help') { help(); return 0 }
        elsif ($opt eq '--version')   { print "oa1 $VERSION (perl $])\n"; return 0 }
        elsif ($opt =~ /^-/)          { print "unknown flag $opt (try --help)\n"; return 2 }
        else { push @rest, $opt }
    }
    $cfg{turns} = 12 unless $cfg{turns} =~ /^\d+$/ && $cfg{turns} > 0;
    $cfg{timeout} = 0 unless $cfg{timeout} =~ /^\d+$/;
    if ($cfg{ascii} eq '-1') {
        my $lang = join(' ', map { defined $ENV{$_} ? $ENV{$_} : '' } qw(LC_ALL LC_CTYPE LANG));
        $cfg{ascii} = ($lang =~ /utf-?8/i) ? 0 : 1;
    }
    $cfg{ascii} = ($cfg{ascii} =~ /^(?:0|off|no|utf-?8)$/i) ? 0 : 1;
    $cmd = shift @rest if !defined $cmd && @rest && $rest[0] =~ /^(?:ask|do|resume|models|doctor|config|help|version)$/;
    $text = join(' ', @rest);
    $cmd = 'repl' unless defined $cmd;
    $cmd = 'ask' if $cmd eq 'repl' && length $text;

    if ($cmd eq 'help')    { help(); return 0 }
    if ($cmd eq 'version') { print "oa1 $VERSION (perl $])\n"; return 0 }
    if ($cmd eq 'config')  { show_config(); return 0 }
    if ($cmd eq 'models')  { return cmd_models() }
    if ($cmd eq 'doctor')  { return cmd_doctor() }

    if ($cmd eq 'resume') {
        my $path = $text;
        unless (length $path && -e $path) {
            print "resume needs a session file:  oa1 resume <file>\n";
            print "your sessions are in /tmp/oa/$< (newest first: ls -t /tmp/oa/$<)\n";
            return 2;
        }
        my $n = session_load($path);
        unless ($n) { print "no messages loaded from $path\n"; return 1 }
        print "resumed $n messages from $path\n";
        repl();
        return 0;
    }

    if (!length $cfg{model} && $cmd ne 'repl') {
        print "no model set: --model NAME, or /model NAME in a session (oa1 models lists them)\n";
        return 2;
    }
    if ($cmd eq 'ask') {
        $cfg{tools} = 0;
        my $r = turn($text);
        return defined $r ? 0 : 1;
    }
    if ($cmd eq 'do') {
        my $r = turn($text);
        return defined $r ? 0 : 1;
    }
    repl();
    return 0;
}

$| = 1;
exit(main()) unless caller;
1;
