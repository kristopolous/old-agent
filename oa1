sub help {
    print <<'HELP';
oa1 - oldagent in one file, for perl 5.001 and up

usage: oa1 [flags] [command] [text]
  (none)        interactive session, tools on
  ask TEXT      one question, no tools
  do TEXT       one task, tools on
  models        list what the endpoint serves
  doctor        the settings, this perl, and whether the endpoint answers
  config        show the settings in use
  help, version

flags
  --provider P     ollama (default, native /api/chat) | openai (/v1/chat/completions)
  --base-url URL   http://host:port (http only)
  --model NAME     model id
  --key KEY        api key, if the endpoint wants one
  --turns N        max tool round trips per task (default 12)
  --timeout N      seconds per model call (default: no limit)
  -y               run bash commands without asking
  --no-tools       no tools, just chat
  --config FILE    use this rc file (default ~/.oldagentrc)
  --no-config      ignore rc files
  -q               only the answer
  --debug          raw replies, calls and results on stderr
  --ascii, --utf8  fold the model's utf-8 punctuation to ascii, or not
                   (default: fold unless LANG says utf-8)
  -p TEXT          same as ask TEXT

in the session: /model NAME, /base URL, /provider P, /approve ask|auto|off,
/tools on|off, /clear, /history, /config, /models, /help, /quit
HELP
}

sub repl {
    print "oa1 $VERSION - $cfg{provider} / $cfg{model} at $cfg{base_url}\n";
    print "type a message; /help for commands, /quit to leave\n\n";
    my ($line, $cmd, $arg);
    while (1) {
        print "> ";
        $line = <STDIN>;
        last unless defined $line;
        chomp $line;
        $line =~ s/^\s+//;
        $line =~ s/\s+$//;
        next unless length $line;
        if ($line =~ m!^/(\w+)\s*(.*)$!) {
            ($cmd, $arg) = ($1, $2);
            last if $cmd =~ /^(?:quit|exit|q)$/;
            if    ($cmd eq 'help') { help() }
            elsif ($cmd eq 'model' && length $arg)    { $cfg{model} = $arg; save_rc('model', $arg); print "model = $arg\n" }
            elsif ($cmd eq 'base' && length $arg)     { $cfg{base_url} = $arg; save_rc('base_url', $arg); print "base_url = $arg\n" }
            elsif ($cmd eq 'provider' && length $arg) { $cfg{provider} = $arg =~ /^openai/ ? 'openai' : 'ollama'; save_rc('provider', $cfg{provider}); print "provider = $cfg{provider}\n" }
            elsif ($cmd eq 'approve' && $arg =~ /^(ask|auto|off)$/) { $cfg{approve} = $1; print "approve = $1\n" }
            elsif ($cmd eq 'tools')   { $cfg{tools} = ($arg =~ /^(?:off|0|no)$/i) ? 0 : 1; print "tools = ", ($cfg{tools} ? 'on' : 'off'), "\n" }
            elsif ($cmd eq 'clear' || $cmd eq 'reset') { @hist = (); print "(history cleared)\n" }
            elsif ($cmd eq 'history') { my $m; for $m (@hist) { my $t = $m->{content}; $t =~ s/\n/ /g; print "  $m->{role}: ", substr($t, 0, 70), "\n" } }
            elsif ($cmd eq 'config')  { show_config() }
            elsif ($cmd eq 'models')  { cmd_models() }
            else { print "unknown command /$cmd (try /help)\n" }
            next;
        }
        turn($line);
        print "\n";
    }
    print "\n";
}

# is the configured model in the list? (perl 5.001 cannot parse grep({...} LIST))
sub model_known {
    my ($names) = @_;
    my $n;
    for $n (@$names) { return 1 if $n eq $cfg{model} }
    return 0;
}

sub cmd_doctor {
    print "oa1 $VERSION - the one-file edition (perl 5.001 and up)\n";
    show_config();
    print "  shell     ", (in_path('sh') ? in_path('sh') : '(no sh: the bash tool cannot run)'), "\n";
    print "  uname     ", (in_path('uname') || in_path('hostinfo') || '(neither uname nor hostinfo)'), "\n";
    print "  tty       ", (-t STDIN ? 'yes' : 'no (bash approval needs one; -y to skip it)'), "\n";
    my ($names, $err) = list_models();
    if ($err) { print "  endpoint  $cfg{base_url}: $err\n"; return 1 }
    print "  endpoint  $cfg{base_url}: ", scalar(@$names), " model(s)",
          (length $cfg{model} ? (model_known($names) ? ", $cfg{model} is one of them" : ", but $cfg{model} is NOT one of them") : ', pick one with --model'), "\n";
    return 0;
}

sub cmd_models {
    my ($names, $err) = list_models();
    if ($err) { print "error: $err\n"; return 1 }
    print "models at $cfg{base_url}:\n";
    my $n;
    for $n (@$names) { print "  $n\n" }
    print "  (none)\n" unless @$names;
    return 0;
}

sub main {
    my (@args, $opt, $cmd, $text);
    @args = @ARGV;
    my @rest;
    # the rc first, then flags on top of it
    while (@args) {
        $opt = shift @args;
        if    ($opt eq '--config')    { $cfg{rcfile} = shift @args }
        elsif ($opt eq '--no-config') { $cfg{noconfig} = 1 }
        else { push @rest, $opt }
    }
    load_rc();
    @args = @rest; @rest = ();
    while (@args) {
        $opt = shift @args;
        if    ($opt eq '--provider')  { $cfg{provider} = shift @args; $cfg{provider} = 'openai' if $cfg{provider} =~ /^openai/ }
        elsif ($opt eq '--base-url' || $opt eq '--base') { $cfg{base_url} = shift @args }
        elsif ($opt eq '--model')     { $cfg{model} = shift @args }
        elsif ($opt eq '--key')       { $cfg{api_key} = shift @args }
        elsif ($opt eq '--turns')     { $cfg{turns} = shift @args }
        elsif ($opt eq '--timeout')   { $cfg{timeout} = shift @args }
        elsif ($opt eq '-y' || $opt eq '--yes') { $cfg{approve} = 'auto' }
        elsif ($opt eq '--no-tools')  { $cfg{tools} = 0 }
        elsif ($opt eq '-q' || $opt eq '--quiet') { $cfg{quiet} = 1 }
        elsif ($opt eq '--debug')     { $cfg{debug} = 1 }
        elsif ($opt eq '--ascii')     { $cfg{ascii} = 1 }
        elsif ($opt eq '--utf8')      { $cfg{ascii} = 0 }
        elsif ($opt eq '-p')          { $cmd = 'ask'; push @rest, shift @args }
        elsif ($opt eq '--cd')        { my $d = shift @args; chdir($d) || die "cannot cd to $d: $!\n" }
        elsif ($opt eq '--proxy')     { shift @args; print STDERR "oa1: --proxy ignored (oa1 talks to the model directly and has no fetch tool)\n" }
        elsif ($opt eq '-h' || $opt eq '--help') { help(); return 0 }
        elsif ($opt eq '--version')   { print "oa1 $VERSION (perl $])\n"; return 0 }
        elsif ($opt =~ /^-/)          { print "unknown flag $opt (try --help)\n"; return 2 }
        else { push @rest, $opt }
    }
    $cfg{turns} = 12 unless $cfg{turns} =~ /^\d+$/ && $cfg{turns} > 0;
    $cfg{timeout} = 0 unless $cfg{timeout} =~ /^\d+$/;
    if ($cfg{ascii} eq '-1') {
        my $lang = join(' ', map { defined $ENV{$_} ? $ENV{$_} : '' } qw(LC_ALL LC_CTYPE LANG));
        $cfg{ascii} = ($lang =~ /utf-?8/i) ? 0 : 1;
    }
    $cfg{ascii} = ($cfg{ascii} =~ /^(?:0|off|no|utf-?8)$/i) ? 0 : 1;
    $cmd = shift @rest if !defined $cmd && @rest && $rest[0] =~ /^(?:ask|do|models|doctor|config|help|version)$/;
    $text = join(' ', @rest);
    $cmd = 'repl' unless defined $cmd;
    $cmd = 'ask' if $cmd eq 'repl' && length $text;

    if ($cmd eq 'help')    { help(); return 0 }
    if ($cmd eq 'version') { print "oa1 $VERSION (perl $])\n"; return 0 }
    if ($cmd eq 'config')  { show_config(); return 0 }
    if ($cmd eq 'models')  { return cmd_models() }
    if ($cmd eq 'doctor')  { return cmd_doctor() }
    if (!length $cfg{model} && $cmd ne 'repl') {
        print "no model set: --model NAME, or /model NAME in a session (oa1 models lists them)\n";
        return 2;
    }
    if ($cmd eq 'ask') {
        $cfg{tools} = 0;
        my $r = turn($text);
        return defined $r ? 0 : 1;
    }
    if ($cmd eq 'do') {
        my $r = turn($text);
        return defined $r ? 0 : 1;
    }
    repl();
    return 0;
}

$| = 1;
exit(main()) unless caller;
1;
